{
  "family": "APP-TASK-DEFINITION",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "2048",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::138852021484:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::138852021484:role/ecs-task-role",

  "containerDefinitions": [
    {
      "name": "APP-1",
      "image": "138852021484.dkr.ecr.ap-south-1.amazonaws.com/app-ecr:IMAGE_TAG",

      "essential": true,

      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],

      "environment": [
        {
          "name": "AWS_REGION",
          "value": "ap-south-1"
        },
        {
          "name": "DB_SERVER",
          "value": "database-1.c5k0ucoc41u3.ap-south-1.rds.amazonaws.com"
        },
        {
          "name": "DB_PORT",
          "value": "5432"
        },
        {
          "name": "DB_DATABASE",
          "value": "postgres"
        }
      ],

      "secrets": [
        {
          "name": "DB_USERNAME",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:138852021484:secret:ecs-app/db-credentials-BVAQXN:username"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:138852021484:secret:ecs-app/db-credentials-BVAQXN:password"
        }
      ],

      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/APP-TASK-DEFINITION",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
